<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/activity_main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F5F1E8">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CURRENCY CONVERTER" android:textColor="#16745F" android:textSize="12sp" android:letterSpacing="0.12" android:layout_marginTop="24dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A world of possibilities." android:textSize="34sp" android:textColor="#101E2B" android:layout_marginTop="16dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Convert U.S. dollars with the latest available daily reference rates." android:textSize="16sp" android:layout_marginTop="16dp" android:textColor="#516675" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/editText" android:text="Amount in USD" android:layout_marginTop="32dp" />
<EditText android:id="@+id/editText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:hint="100.00" android:textSize="28sp" android:singleLine="true" android:maxLength="18" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/currency" android:text="Convert to" android:layout_marginTop="20dp" />
<Spinner android:id="@+id/currency" android:layout_width="match_parent" android:layout_height="56dp" />
<Button android:id="@+id/convert" android:layout_width="match_parent" android:layout_height="56dp" android:text="Convert currency" android:layout_marginTop="20dp" />
<ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
<TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your conversion appears here" android:textSize="28sp" android:textColor="#101E2B" android:layout_marginTop="28dp" android:accessibilityLiveRegion="polite" android:textIsSelectable="true" />
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rates provided by Frankfurter. Reference rates may differ from bank or card rates." android:textColor="#516675" android:textSize="14sp" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" />
</LinearLayout></ScrollView>
