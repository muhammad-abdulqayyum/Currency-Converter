{
  "version": 1,
  "projects": {
    "portfolio": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "assets": [
              {"glob": "*", "input": "src/icons", "output": "icons"},
              {"glob": "*.svg", "input": "node_modules/flag-icons/flags/4x3", "output": "flags"},
              {"glob": "LICENSE", "input": "node_modules/flag-icons", "output": "flags"}
            ],
            "styles": [
              "src/styles.css"
            ],
            "outputPath": {
              "base": "dist",
              "browser": ""
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "portfolio:build"
          }
        }
      }
    }
  }
}