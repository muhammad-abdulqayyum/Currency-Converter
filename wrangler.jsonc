{
  "observability": { "logs": { "enabled": true, "invocation_logs": true, "persist": true } },
  "name": "universal-currency-converter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
